from scipy.optimize import curve_fit
import numpy as np

# Define the complex model function
def model_function(P, k, beta, P0, gamma):
    return k * P**beta * (1 - np.exp(-(P / P0)**gamma))

# Count the number of stars for normalization (from filtered_allstars)
num_stars = len(filtered_allstars)

# Create figure for the curve fits
fig, ax = plt.subplots(figsize=(8, 6))

# 🔹 **Plot and Fit Each Radius Bin**
for min_radius, max_radius, color, label in radius_bins:
    # Filter planets in this radius range
    filtered_confirmed = filtered_planets[(filtered_planets['pl_rade'] >= min_radius) & 
                                          (filtered_planets['pl_rade'] < max_radius)]
    
    filtered_candidates = filtered_Cplanets[(filtered_Cplanets['koi_prad'] >= min_radius) & 
                                            (filtered_Cplanets['koi_prad'] < max_radius)]
    
    # Concatenate orbital periods
    all_periods = np.concatenate([
        filtered_confirmed['pl_orbper'].dropna(),
        filtered_candidates['koi_period'].dropna()
    ])
    
    # Compute histogram for planet occurrence per star
    occurrence_counts, period_bins = np.histogram(all_periods, bins=np.logspace(np.log10(0.68), np.log10(50), 15))
    period_centers = np.sqrt(period_bins[:-1] * period_bins[1:])  # Geometric mean of bins
    occurrence_per_star = occurrence_counts / num_stars  # Normalize
    
    # Poisson errors on the occurrence counts
    occurrence_errors = np.sqrt(occurrence_counts) / num_stars
    
    # Fit the curve to the data
    popt, pcov = curve_fit(model_function, period_centers, occurrence_per_star, p0=(1, -1, 10, 1))
    
    # Calculate parameter uncertainties (standard deviations)
    perr = np.sqrt(np.diag(pcov))  # Standard deviations of the parameters
    
    # Print the fitted parameters and their uncertainties
    print(f"Fit for {label}:")
    print(f"  k = {popt[0]:.4f} ± {perr[0]:.4f}")
    print(f"  beta = {popt[1]:.4f} ± {perr[1]:.4f}")
    print(f"  P0 = {popt[2]:.4f} ± {perr[2]:.4f}")
    print(f"  gamma = {popt[3]:.4f} ± {perr[3]:.4f}")
    print()
    
    # Plot the data with error bars and the fitted curve
    ax.errorbar(period_centers, occurrence_per_star, yerr=occurrence_errors, fmt='o', 
                color=color, capsize=3)
    ax.plot(period_centers, model_function(period_centers, *popt), color=color, linestyle='-', label=f'{label} (fit)')

# 🔹 **Overall Distribution (All Planets)**
all_periods_all = np.concatenate([
    filtered_planets['pl_orbper'].dropna(),
    filtered_Cplanets['koi_period'].dropna()
])

occurrence_counts_all, period_bins_all = np.histogram(all_periods_all, bins=np.logspace(np.log10(0.68), np.log10(50), 15))
period_centers_all = np.sqrt(period_bins_all[:-1] * period_bins_all[1:])
occurrence_per_star_all = occurrence_counts_all / num_stars

# Poisson errors on the overall distribution
occurrence_errors_all = np.sqrt(occurrence_counts_all) / num_stars

# Fit the curve to the overall distribution
popt_all, pcov_all = curve_fit(model_function, period_centers_all, occurrence_per_star_all, p0=(1, -1, 10, 1))

# Calculate parameter uncertainties for the overall fit
perr_all = np.sqrt(np.diag(pcov_all))

# Print the fitted parameters and their uncertainties for the overall fit
print("Fit for All Planets:")
print(f"  k = {popt_all[0]:.4f} ± {perr_all[0]:.4f}")
print(f"  beta = {popt_all[1]:.4f} ± {perr_all[1]:.4f}")
print(f"  P0 = {popt_all[2]:.4f} ± {perr_all[2]:.4f}")
print(f"  gamma = {popt_all[3]:.4f} ± {perr_all[3]:.4f}")
print()

# Plot the data with error bars and the fitted curve for all planets
ax.errorbar(period_centers_all, occurrence_per_star_all, yerr=occurrence_errors_all, fmt='o', 
            color='black', label='All Planets (data)', ecolor='black', capsize=3)
ax.plot(period_centers_all, model_function(period_centers_all, *popt_all), color='black', linestyle='-', label='All Planets (fit)')

# Formatting
ax.set_xlabel("Orbital Period (days)")
ax.set_ylabel("Planet Occurrence per Star")
ax.grid(True, which='both', linestyle='--', alpha=0.5)
plt.yscale('log')
plt.legend()
plt.tight_layout()
